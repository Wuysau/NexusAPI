{
  "name": "nexusapi",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "node scripts/build-control.mjs",
    "start": "node .next/standalone/start-control.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && eslint .",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:security": "vitest run tests/security --no-file-parallelism",
    "test:e2e": "node scripts/smoke-test.mjs",
    "budget:dev": "tsx services/budget/index.ts",
    "worker:dev": "tsx services/worker/index.ts",
    "observer:dev": "node --env-file-if-exists=.env.local --import tsx services/observer/index.ts",
    "observer:build": "node scripts/build-services.mjs observer",
    "observer:codex": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.observer.local --import tsx scripts/observer-codex.ts",
    "gateway:build": "cd services/gateway && go build ./...",
    "gateway:local": "node scripts/start-local-gateway.mjs",
    "gateway:test": "cd services/gateway && go test ./...",
    "gateway:race": "cd services/gateway && go test -race ./...",
    "gateway:vet": "cd services/gateway && go vet ./...",
    "gateway:fmt": "node scripts/check-go-format.mjs",
    "db:generate": "drizzle-kit generate",
    "seed:dev": "node --env-file-if-exists=.env.local scripts/seed-dev.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migration:verify": "drizzle-kit check && vitest run tests/integration/canonical-migrations.test.ts tests/integration/legacy-migration.test.ts --no-file-parallelism",
    "db:legacy": "node scripts/legacy-migration.mjs",
    "security:check": "npm audit --audit-level=high --omit=dev",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "services:build": "node scripts/build-services.mjs",
    "worker:build": "node scripts/build-services.mjs worker",
    "budget:build": "node scripts/build-services.mjs budget",
    "gateway:check": "node scripts/check-gateway.mjs",
    "ci:validate": "node scripts/validate-ci.mjs",
    "ci:plan": "node scripts/ci-plan.mjs",
    "ci:images": "node scripts/ci-images.mjs",
    "ci:e2e": "node scripts/ci-e2e.mjs",
    "ci:sbom": "node scripts/ci-sbom.mjs",
    "ci:go": "node scripts/ci-go.mjs",
    "ci:negative": "node scripts/ci-negative.mjs",
    "secrets:verify:fixture": "node scripts/verify-secret-plane-runtime.mjs",
    "secret:enroll": "node scripts/secret-enroll.mjs",
    "compose:verify": "node scripts/verify-production-compose.mjs"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "pg": "8.20.0",
    "playwright": "^1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "js-yaml": "4.3.2",
    "postcss": "8.5.8",
    "prettier": "^3.9.6",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT",
  "description": "OpenAI-compatible LLM gateway and usage management console"
}
