{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/secret-registry.schema.json",
  "title": "Nexus operator signed secret registry v1",
  "description": "Validate outer envelope and decoded payload separately. Signature, strict UTF8/JSON parsing, canonical base64, context binding, origin/IP policy and freshness semantics are mandatory verifier checks outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "signing_key_id", "payload_base64", "signature_base64"],
  "properties": {
    "format": {
      "const": "nexus.secret-registry.signed.v1"
    },
    "signing_key_id": {
      "$ref": "#/$defs/identifier"
    },
    "payload_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 16777216,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signature_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1048576,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "credential_id",
        "credential_version",
        "provider_id",
        "allowed_https_origins",
        "context_base64",
        "vault",
        "encrypted"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/identifier"
        },
        "credential_id": {
          "$ref": "#/$defs/identifier"
        },
        "credential_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provider_id": {
          "$ref": "#/$defs/identifier"
        },
        "allowed_https_origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^https://(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?(?::[1-9][0-9]{0,4})?$"
          }
        },
        "context_base64": {
          "$ref": "#/$defs/base64"
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mount", "key", "wrapped_dek"],
          "properties": {
            "mount": {
              "$ref": "#/$defs/identifier"
            },
            "key": {
              "$ref": "#/$defs/identifier"
            },
            "wrapped_dek": {
              "type": "string",
              "maxLength": 16384,
              "pattern": "^vault:v[1-9][0-9]*:(?:[A-Za-z0-9+/]{4})+(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        "encrypted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "nonce_base64", "ciphertext_base64", "tag_base64"],
          "properties": {
            "algorithm": {
              "const": "AES-256-GCM"
            },
            "nonce_base64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{16}$"
            },
            "ciphertext_base64": {
              "$ref": "#/$defs/base64"
            },
            "tag_base64": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{22}==$"
            }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "registry_id",
        "registry_version",
        "revocation_epoch",
        "issued_at",
        "expires_at",
        "entries"
      ],
      "properties": {
        "format": {
          "const": "nexus.secret-registry.payload.v1"
        },
        "registry_id": {
          "$ref": "#/$defs/identifier"
        },
        "registry_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "entries": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      }
    }
  }
}
