{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BudgetRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "organization_id",
    "request_id",
    "key_id",
    "model_id",
    "provider",
    "price_version_id",
    "sale_price_snapshot_id",
    "version",
    "currency",
    "exchange_rate_snapshot_id",
    "estimated_input_tokens",
    "estimated_output_tokens",
    "ttl_seconds"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "price_version_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sale_price_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "version": {
      "const": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "exchange_rate_snapshot_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "estimated_input_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "estimated_output_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4194304
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "attribution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "api_key_id",
        "key_kind",
        "principal_id",
        "attribution_status",
        "requested_model",
        "streaming",
        "catalog_version_id",
        "policy_version_id"
      ],
      "properties": {
        "project_id": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "project_name": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "api_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "key_kind": {
          "enum": ["shared", "personal", "service", "unknown"]
        },
        "principal_id": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "attribution_status": {
          "enum": ["attributed", "unattributed"]
        },
        "requested_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "streaming": {
          "type": "boolean"
        },
        "catalog_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "policy_version_id": {
          "type": ["string", "null"],
          "maxLength": 128,
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key_kind": {
                "const": "shared"
              }
            }
          },
          "then": {
            "properties": {
              "principal_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "attribution_status": {
                "const": "attributed"
              }
            }
          },
          "then": {
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "project_id": {
                "type": "null"
              },
              "project_name": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
