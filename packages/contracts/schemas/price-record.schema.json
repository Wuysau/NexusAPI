{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/price-record.schema.json",
  "title": "NexusPriceRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model_id",
    "currency",
    "components",
    "effective_from",
    "source",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string" },
    "model_id": { "type": "string" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "status": { "enum": ["fetched", "validated", "pending_approval", "scheduled", "active", "superseded", "rejected"] },
    "effective_from": { "type": "string", "format": "date-time" },
    "effective_to": { "type": ["string", "null"], "format": "date-time" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "unit", "amount"],
        "properties": {
          "kind": { "enum": ["input", "cached_input", "output", "reasoning", "request", "image", "audio", "storage"] },
          "unit": { "type": "string" },
          "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "conditions": { "type": "object" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrieved_at", "content_sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "approved_by": { "type": ["string", "null"] },
    "approved_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
