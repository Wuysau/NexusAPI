# NexusAPI Environment Variables
#
# Copy to .env.local and fill in real values. .env.local is gitignored
# (see .gitignore).
#
# Production is fail-closed: missing [required] vars cause startup failure.

# [required] PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# [required] Public base URL (callbacks, security headers, SameSite cookie domain)
APP_BASE_URL=http://localhost:3000

# [optional/public] Go Gateway Base URL, including /v1, for client documentation.
# Explicit deployment address; never the Control Plane URL. No credentials/query/fragment.
# Set before building Next.js (NEXT_PUBLIC values are embedded in the browser bundle).
# Example: http://localhost:8080/v1. Empty/invalid values hide request examples.
NEXT_PUBLIC_GATEWAY_BASE_URL=

# Local Ollama connector: enable on BOTH Control Plane and Gateway.
NEXUS_CONNECTORS_ENABLED=false
# Control Plane's fixed Gateway origin for console test calls (HTTPS in production).
NEXUS_GATEWAY_URL=
# Connector v1 is a single Gateway deployment; startup also acquires a DB singleton lock.
GATEWAY_REPLICAS=1
# Native Gateway TLS is required for production connectors.
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Container readiness: certificate DNS name and optional private CA bundle.
GATEWAY_HEALTHCHECK_TLS_SERVER_NAME=
GATEWAY_HEALTHCHECK_CA_FILE=
# Optional private CA for Gateway -> Control Plane HTTPS (PEM).
CONTROL_PLANE_CA_FILE=

# [production-required] Routing snapshot HMAC key, >=32 chars. This is not a
# provider encryption key or operator Ed25519 registry signing key.
SNAPSHOT_SIGNING_KEY=
# SNAPSHOT_SIGNING_KEY_VERSION=1
# SNAPSHOT_SIGNING_KEY_PREVIOUS=
# SNAPSHOT_SIGNING_KEY_PREVIOUS_VERSION=0
# Development fixture helpers only. NEVER mount the old wrapping key into production CP.
# UPSTREAM_ENCRYPTION_KEY=

# [production-required] Admin access token (>=24 chars).
# Used by the legacy admin surface; primary auth is user/org/RBAC.
ADMIN_TOKEN=

# [gateway-required] Fail-closed token for the internal gateway API
# (snapshot only; plaintext credential endpoint retired). The Go gateway must send this as
# a Bearer token. Must NOT equal SNAPSHOT_SIGNING_KEY in production.
GATEWAY_INTERNAL_TOKEN=

# [optional/gateway-only] Bearer credential for GET /metrics (>=24 characters).
# Empty disables scraping. Use a separate random secret, not a project API key.
GATEWAY_METRICS_TOKEN=

# [orders-required] Fail-closed token for the internal orders API.
# Separate from GATEWAY_INTERNAL_TOKEN so the console and data plane
# do not share an identity.
INTERNAL_ORDERS_TOKEN=

# [sandbox] Shared secret for mock payment provider webhooks.
# Required to exercise the payment sandbox. Not used in production.
MOCK_PAYMENT_WEBHOOK_SECRET=

# [optional] Encryption key rotation: previous key for decrypting historical ciphertext.
# UPSTREAM_ENCRYPTION_KEY_PREVIOUS=
# UPSTREAM_ENCRYPTION_KEY_PREVIOUS_VERSION=0

# [production-gateway-required] Redis for distributed rate limits, admission and task locks.
# Production admission fails closed on missing/unavailable Redis; local fallback is dev/test only.
REDIS_URL=redis://127.0.0.1:6379

# [production-required] Vault crypto is performed by independent operator/Gateway workloads.
# CP validates this mode but has no Vault token, private signer or wrapping key.
# KMS_PROVIDER=vault
# LocalKms remains a development fixture helper; production bypasses are rejected.
# Gateway-only deployment configuration (never mount these into Control Plane):
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TOKEN_FILE=/run/secrets/gateway-vault-token
# VAULT_CA_FILE=/run/secrets/vault-ca.pem
# SECRET_REGISTRY_FILE=/run/secrets/registry.json
# SECRET_REGISTRY_TRUST_FILE=/run/secrets/registry-trust.json
# SECRET_REGISTRY_ID=customer-registry
# SECRET_REGISTRY_FLOOR_FILE=/var/lib/nexus-secret-registry/floor.json
# SECRET_VAULT_RESOURCES=transit/nexus-provider-v1
# SECRET_ALLOWED_ORIGINS=https://api.example.com

# [optional] Session TTL (seconds). Default 8h, range 5m–7d.
# SESSION_TTL_SECONDS=28800
# SESSION_COOKIE_DOMAIN=

# [gateway] Gateway configuration (services/gateway/)
# GATEWAY_ENV=development
# GATEWAY_ADDR=:8080
# CONTROL_PLANE_URL=http://127.0.0.1:3000
# GATEWAY_SNAPSHOT_REFRESH_SECONDS=30
# GATEWAY_SNAPSHOT_MAX_AGE_SECONDS=300
# GATEWAY_MAX_CONCURRENT=256
# Per-channel shared cap across gateway instances and tenants (1–100000).
# GATEWAY_CHANNEL_MAX_CONCURRENT=64
# Admission wait in milliseconds: 0 rejects immediately; maximum 30000.
# GATEWAY_CONCURRENCY_WAIT_MS=0
# Buffered output content limit: default 16 MiB, range 4096–67108864 bytes.
# GATEWAY_MAX_RESPONSE_BYTES=16777216
# GATEWAY_REQUESTS_PER_MINUTE=600
# GATEWAY_TOKENS_PER_MINUTE=2000000
# GATEWAY_ENABLE_RESPONSES=false

# [worker] Worker configuration (services/worker/)
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_BATCH_SIZE=25
# WORKER_MAX_ATTEMPTS=5
# WORKER_RECONCILE_INTERVAL_MS=60000

# [test] E2E test target origin
# TEST_ORIGIN=http://localhost:3000

# Private accounting authorization (ADR-0008); never reuse the Control Plane token.
BUDGET_SERVICE_URL=http://127.0.0.1:8081
BUDGET_SERVICE_TOKEN=
BUDGET_HOST=127.0.0.1
BUDGET_PORT=8081

# Production Compose only: full URLs must use distinct provisioned login roles.
# DATABASE_URL remains the canonical variable inside every service.
DATABASE_URL_CONTROL=
DATABASE_URL_GATEWAY=
DATABASE_URL_WORKER=
DATABASE_URL_BUDGET=
DB_OWNER_PASSWORD=
# Operator-only provisioning (never supply these to application containers).
DATABASE_ADMIN_URL=
DB_CONTROL_PASSWORD=
DB_GATEWAY_PASSWORD=
DB_WORKER_PASSWORD=
DB_BUDGET_PASSWORD=
# NEXUS_BUILD_CONTEXT=.  # only when using --project-directory . from repo root
# WORKER_HEARTBEAT_FILE=/tmp/nexus-worker-heartbeat.json
# Local Subscription Observer (same DATABASE_URL as the app)
CODEX_OBSERVER_ENABLED=true
CODEX_OBSERVER_INTERVAL_SECONDS=60
# CODEX_OBSERVER_CONFIG_PATH=config/nexus-observer.json
# Optional CodexBar dashboard bridge; server-only and explicitly tenant-scoped.
# CODEXBAR_DASHBOARD_URL=http://127.0.0.1:8380
# CODEXBAR_DASHBOARD_TOKEN=
# CODEXBAR_DASHBOARD_TENANT_ID=
# CODEXBAR_DASHBOARD_ORGANIZATION_ID=
# Stripe hosted checkout (control plane only). See docs/operations/stripe-payments.md.
# Keep test/live in separate deployments/databases. Never expose keys to browser.
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CHECKOUT_ORIGIN=https://nexus.example
# Optional local desktop credential directory; defaults to ~/.nexusapi/credentials.
# Set the same absolute directory for the development Go gateway to use keys saved in the UI.
# Production rejects this profile. Never place this directory inside the repository.
# NEXUS_LOCAL_CREDENTIAL_DIR=C:/Users/YOUR_USER/.nexusapi/credentials
